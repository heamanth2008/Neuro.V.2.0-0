# Neuro Music - Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Environment: dev, prod, or test
ENV=dev

# Database URL (sqlite for local dev, postgresql for production)
# For Render: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# JWT Secret - REQUIRED, generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT Token expiry in minutes (default: 30 days)
JWT_EXPIRE_MINUTES=43200

# CORS Allowed Origins (comma-separated, required for credentials)
# Example: http://localhost:3000,https://your-domain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# YouTube Data API v3 Key (required for search)
# Get from: https://console.cloud.google.com/apis/credentials
YT_API_KEY=

# SMTP Settings (optional, for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Neuro Music

# App Version
APP_VERSION=2.0.0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60